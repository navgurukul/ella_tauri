{
  "name": "ella-tauri-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dev:local": "ELLA_ENGINE_MODE=local tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:bundle": "tauri build --bundles app --no-sign",
    "engines:local": "./scripts/start-local-engines.sh",
    "local": "./scripts/run-local-poc.sh",
    "models:install": "node scripts/models.mjs install",
    "models:validate": "node scripts/models.mjs validate",
    "benchmark:stt": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin stt-benchmark --",
    "check": "npm run test && npm run build && cargo test --manifest-path src-tauri/Cargo.toml",
    "telemetry:report": "python3 scripts/latency-report.py",
    "bench:chore": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin chore-bench --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
